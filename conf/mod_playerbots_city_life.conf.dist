###################################################################################################
# CITY LIFE - cities, local questing, duels and world PvP
###################################################################################################
# One module, one configuration file: mod_playerbots_city_life.conf.
# Existing CityLife.* and PvPLife.* option names and defaults are retained.
# Coordinates, faction data, hotspot weights and chat lines remain in the WORLD database.
# Use tools/merge_life_config.py to carry your personal settings over from the former two files.
#
# Contents:
#   01  Component switches
#   02  City population, bot selection, time scaling and behaviour
#   03  Cities and towns - one Enable and Population pair per location
#   04  Quest zones - separate Alliance and Horde hubs
#   05  PvP bot selection and movement
#   06  Duel zones and real-player challenges
#   07  World-PvP locations
#   08  For the Horde / For the Alliance
#   09  Bot chat and PvP strategies
#   10  Custom city characters, training and social interactions
#   11  Fishing Life - waterfront locations and dedicated fishing populations
#
# Enable: 1 = on, 0 = off. A configured Enable value takes precedence over the database flag.
# Normal populations borrow online bots; Custom and Fishing Life have separate CreateMissing settings.
# Optional city/quest additions are opt-in. Custom and Fishing Life default ON within the shared city cap.
# Apply the two *_locations.sql additive files once before enabling their new locations.
# After editing this file, use .reload config or restart worldserver.
# .citylife reload reloads database hubs/spots only; it does not reread this file.

[worldserver]

###################################################################################################
# 01 - COMPONENT SWITCHES
###################################################################################################
# CityLife.Enable controls the shared scheduler for residents, questing, Custom and Fishing Life.
# Questing additionally needs CityLife.Questing.Enable = 1 in section 04.
# PvPLife.Enable independently controls all duel, world-PvP and faction-campaign activity.

CityLife.Enable = 1
PvPLife.Enable = 1

###################################################################################################
# 02 - CITY POPULATION AND GENERAL BEHAVIOUR
###################################################################################################

# Startup and diagnostics

# Verbose population and movement logs.
CityLife.Debug = 0

# Wait for random playerbots to log in before reserving city residents.
CityLife.StartupDelaySeconds = 90

# Population/behaviour manager interval. Lower values react faster but cost more CPU.
CityLife.TickSeconds = 10

# Bot selection and release

# Read the random-bot account prefix and login delay from mod-playerbots.
CityLife.Bots.UsePlayerbotConfig = 1

# "auto" uses Playerbots.RandomBotAccountPrefix.
CityLife.Bots.AccountPrefix = "auto"

# Optional account-id range. 0/0 disables range filtering.
CityLife.Bots.AccountMin = 0

CityLife.Bots.AccountMax = 0

CityLife.Bots.QueryLimit = 500

CityLife.Bots.SkipGrouped = 1

# Keep disabled for normal random-playerbot installations. BotActiveAlone may otherwise reject most bots.
# This bypass applies only to city residents. Questers always require Playerbots full AI activity.
CityLife.Bots.RespectPlayerbotActivity = 0

# Return released residents to the position from which City Life borrowed them.
CityLife.Bots.ReturnWhenReleased = 1

# Population safety limits and online-bot planning

# Required online bots >= Life reservations + simultaneous dungeon/BG bot slots + spare bots.
# Budget Life bots as unavailable: residents/questers disable normal BG/LFG joining. Manual recruitment
# can release their Life assignment; returning to the same quest hub is not guaranteed.
# With Custom + Fishing defaults, targets are morning 286 / day 300 / evening 300 / night 205.
# Questing and optional city/quest additions default OFF; 16 Custom + 46 Fishing slots default ON.
# Normal residents + Custom roles + Fishing Life + questers share the 300 cap below;
# PvP is separate and can request up to 140 more, so budget up to 440 Life bots automatically.
# This is a default planning peak, not a universal cap: changed settings or GM starts can exceed it.
# Examples at that peak: 500 online -> 60 free; 1,000 -> 560 free; 2,000 -> 1,560 free.
# Use 1,000 ONLINE bots as an illustrative budget for the current profile; 2,000 leaves more room
# to enable additional locations. These are population examples, not measured server requirements.
# With ALL city/quest hubs, default Custom and Fishing at full scaling, the request is 594.
# If MaxTotal is at least 594, plus unchanged PvP demand of 140, budget 734 Life bots / 1,266 free at 2,000.
# Adjust for concurrent demand and server capacity; if the pool varies, plan against MinRandomBots,
# not MaxRandomBots or offline characters. Include extra Custom/Fishing-managed online bots in the total.
# No minimum free pool is enforced here; CreateMissing.MaxBots is separate from Playerbots online limits.
# Especially with leveling bots, keep free bots in EACH faction/BG level bracket and enough eligible
# level-80 tanks, healers and damage dealers for heroic dungeons (RHC). Low-level bots cannot fill them.
# One 5-player dungeon with one real player needs 4 eligible bots; BGs need slots on both teams.
# If too few eligible bots remain, lower hub populations/PvP demand or increase the Playerbots online pool.

# Global safety cap after per-hub settings and time multipliers are applied.
# Higher-priority hubs from city_life_hub are filled first when this limit is reached.
CityLife.Population.MaxTotal = 300

# Gradual arrivals/departures prevent visible mass teleports and reduce update spikes.
CityLife.Population.MaxChangesPerTick = 3

# Time-of-day scaling

CityLife.Time.Enable = 1

# Morning 06:00-11:59, day 12:00-17:59, evening 18:00-23:59, night 00:00-05:59.
# 100 means the full configured hub population.
CityLife.Time.MorningMultiplierPct = 60

CityLife.Time.DayMultiplierPct = 80

CityLife.Time.EveningMultiplierPct = 100

CityLife.Time.NightMultiplierPct = 25

# Resident movement and social behaviour

# Move residents between the hub's AH/bank/mail/flight/square spots occasionally.
CityLife.Behaviour.Relocate = 1

CityLife.Behaviour.RelocateMinSeconds = 180

CityLife.Behaviour.RelocateMaxSeconds = 600

# Drift-recovery distance in yards after arrival; normal relocation is never a leash violation.
# Recovery uses a validated walking path, not a teleport. Combat is never interrupted.
CityLife.Behaviour.LeashRadius = 35

CityLife.Behaviour.Emotes = 1

CityLife.Behaviour.EmoteChancePct = 35

CityLife.Behaviour.EmoteMinSeconds = 120

CityLife.Behaviour.EmoteMaxSeconds = 360

# Give AH and bank spots in the listed hubs more residents than other hotspots.
# 250 means 2.5 times their normal database weight.
CityLife.Behaviour.ServiceSpotWeightMultiplierPct = 250

# Percentage of residents initially assigned to those service spots that remain stationary.
# They may still emote and defend themselves if attacked.
CityLife.Behaviour.StaticServiceChancePct = 80

CityLife.Behaviour.StaticServiceHubs = "Stormwind,Orgrimmar"

CityLife.Behaviour.StaticServiceCategories = "auction,bank"

# Resident strategies

# City bots stay defensive if attacked but do not grind, travel or wander away on their own.
# City Life suppresses competing non-combat movement (including stay's return action) while reserved.
CityLife.Strategies.NonCombat = "+stay,-follow,-passive,-grind,-rpg,-travel,-duel,-pvp"


