###################################################################################################
# 10 - CUSTOM CITY LIFE
###################################################################################################
# Independent of PvPLife.Enable; CityLife.Enable must also be ON.
# All six features default ON. Each feature has its own Enable switch.
# Fishing Life has its own separate section 11 and is unaffected by CityLife.Custom.Enable.
# Dedicated roles use real playerbots and count INSIDE CityLife.Population.MaxTotal.
# If no eligible bot is available, CreateMissing can create/log in a separate module-owned participant.
# Default requests: 9 Legendary + 2 Beggar + 3 Buyer + 2 TrainingDummy = 16 bots.
# Reactions and conversations reuse normal residents and do not reserve additional bots.
# Population is per city: set 0 to disable that role in one city, or raise it to request more.
# More requested bots need matching online faction/level candidates and safe spots/MMAP data.
# Default beggars use actual level-1 bots; CreateMissing can provision them without lowering another character.
# Run world_city_life_custom.sql on WORLD, and both characters_city_life_custom*.sql files on CHARACTERS.
# Existing WORLD coordinates, faction assignments, weights and chat texts remain editable data.
# Missing Custom data disables only Custom functionality; the original module remains usable.

CityLife.Custom.Enable = 1

# Create and log in a missing Custom participant at an allowed level, using module-owned accounts.
# Existing correctly leveled managed characters are reused; existing characters are never downleveled.
# These bots are additional to the normal Playerbots MinRandomBots/MaxRandomBots online pool.
# Count them in TOTAL online-bot budgets. All assigned Custom roles still share the CityLife 300 cap.
# MaxBots limits persistent NON-FISHING managed characters, including pending work; not role population.
# Fishing Life uses a separate quota in section 11; existing registered fishing identities are retained.
# Creation is gradual and can fail/retry if an account, character, login or quota requirement cannot be met.
# Disabling CreateMissing stops provisioning; existing managed records remain reusable after reenabling.
CityLife.Custom.CreateMissing.Enable = 1
CityLife.Custom.CreateMissing.MaxBots = 30
CityLife.Custom.CreateMissing.CreateIntervalSeconds = 30
CityLife.Custom.CreateMissing.AccountPrefix = "citylife"

# Keep Custom roles at the configured population throughout the day.
# Set 1 to apply the normal CityLife.Time multipliers to these roles too.
CityLife.Custom.TimeScaling = 0

# 0 keeps a role assigned until disabled/unavailable; positive seconds rotate participants.
CityLife.Custom.ResidenceSeconds = 0

# Ambient role chat requires a real player within this many yards, on the same map/phase.
CityLife.Custom.Chat.Range = 40

# Legendary AFK characters - three per city by default.
# Class-specific outfits and the mount are configured below. Original equipment is restored on release.
CityLife.Custom.Legendary.Enable = 1
# Keep the same module-managed character for each city/slot, including after a restart.
# New fixed slots need CreateMissing enabled; existing registered slots remain reusable.
CityLife.Custom.Legendary.FixedIdentity = 1
CityLife.Custom.Legendary.MinLevel = 80
CityLife.Custom.Legendary.MaxLevel = 80
CityLife.Custom.Legendary.Stormwind.Population = 3
CityLife.Custom.Legendary.Orgrimmar.Population = 3
CityLife.Custom.Legendary.Dalaran.Population = 3

# Class mix for NEW managed Legendary identities. Names or class IDs, separated by commas.
# New slots prefer the least represented eligible class in that city; ties use this order.
# Existing identities/classes remain unchanged. Empty quotes stop new Legendary identities.
CityLife.Custom.Legendary.Classes = "Warrior,Rogue,Paladin"

# Raw creature display ID, not a mount item or spell. 21974 = Swift Spectral Tiger.
# Fixed fallback when random selection is disabled/empty; 0 disables all Legendary mount visuals.
CityLife.Custom.Legendary.MountDisplayId = 21974
# Choose a stable mount per character from this list; restarts keep the same selection.
# 21974 = Swift Spectral Tiger; 15676 = Black Qiraji Battle Tank. No mount is permanently learned.
CityLife.Custom.Legendary.Mount.Randomize = 1
CityLife.Custom.Legendary.Mount.DisplayIds = "21974,15676"

# Full Phase 4 BiS profiles bundled from mod-npc-talent-template, including the real BiS weapons.
# The template NPC module does not need to be installed. 0 uses the earlier Tier 10 outfits.
# Enchants/gems affect generated temporary items only; borrowed original items remain intact.
CityLife.Custom.Legendary.TemplateGear.Enable = 1
# Ashen Verdict BiS rings require Exalted. Grant it only to module-owned Legendary characters.
# This persistent reputation is retained when disabled, just like saved HK/achievement history.
CityLife.Custom.Legendary.TemplateGear.ExaltedReputation = 1
CityLife.Custom.Legendary.Enchants.Enable = 1
CityLife.Custom.Legendary.Gems.Enable = 1

# Temporary T6 armor and legendary weapon appearances; real BiS stats, enchants and gems stay intact.
# Requires this update of mod-transmog, with BOTH modules enabled and built statically.
# Missing/disabled transmog keeps the real BiS appearance. Normal player transmog rules stay unchanged.
# Only default TemplateGear profiles use these skins. DK keeps its BiS armor: there is no DK T6 set.
# HideOffhand hides only the extra visual when a two-handed weapon skin is used; its stats remain.
# No permanent appearance collection unlocks or learned mount are granted by these cosmetics.
CityLife.Custom.Legendary.Skins.Enable = 1
CityLife.Custom.Legendary.Skins.Armor.Enable = 1
CityLife.Custom.Legendary.Skins.Weapons.Enable = 1
CityLife.Custom.Legendary.Skins.HideOffhand = 1

# "default" selects the bundled class-specific BiS profiles, with the separate cosmetic options above.
# To customize, use item-entry IDs separated by commas; separate alternative outfits with semicolons.
# Example Warrior.Outfits = "51227,51229,51225,51226,51228,32837,32838"
# Empty quotes disable that class's Legendary selection. Invalid/ineligible profiles are skipped.
# A character keeps a deterministic choice from its usable alternatives; config changes can change it.
CityLife.Custom.Legendary.Warrior.Outfits = "default"
CityLife.Custom.Legendary.Paladin.Outfits = "default"
CityLife.Custom.Legendary.Hunter.Outfits = "default"
CityLife.Custom.Legendary.Rogue.Outfits = "default"
CityLife.Custom.Legendary.Priest.Outfits = "default"
CityLife.Custom.Legendary.DeathKnight.Outfits = "default"
CityLife.Custom.Legendary.Shaman.Outfits = "default"
CityLife.Custom.Legendary.Mage.Outfits = "default"
CityLife.Custom.Legendary.Warlock.Outfits = "default"
CityLife.Custom.Legendary.Druid.Outfits = "default"

# Persistent veteran history is applied ONLY to verified module-owned Legendary characters.
# These are minimum lifetime HK and achievement POINTS, not spendable honor or achievement counts.
# Raising values can add history; lowering/disabling does not erase already saved progress.
# Randomize chooses different stable targets per character; restarts keep the same identity's targets.
# HK defaults vary from 11,000 to 25,000; achievement targets vary from 5,100 to 6,000 points.
# Set each Randomize switch to 0 to use the fixed HonorableKills / AchievementPoints value instead.
CityLife.Custom.Legendary.Honor.Enable = 1
CityLife.Custom.Legendary.Honor.Randomize = 1
CityLife.Custom.Legendary.HonorableKills = 10000
CityLife.Custom.Legendary.HonorableKills.Min = 11000
CityLife.Custom.Legendary.HonorableKills.Max = 25000
CityLife.Custom.Legendary.Achievements.Enable = 1
CityLife.Custom.Legendary.Achievements.Randomize = 1
CityLife.Custom.Legendary.AchievementPoints = 5000
CityLife.Custom.Legendary.AchievementPoints.Min = 5100
CityLife.Custom.Legendary.AchievementPoints.Max = 6000

# "default" uses validated dungeon/raid/general achievements; realm-first and reward-mail entries are excluded.
# Custom values are comma-separated achievement IDs, still subject to validity and safety checks.
CityLife.Custom.Legendary.AchievementIds = "default"

# Shared across all cities and factions. No custom tabard, ranks or permanent pet are assigned.
# An unrelated guild with the same name is left untouched; membership is then skipped.
CityLife.Custom.Legendary.Guild.Enable = 1
CityLife.Custom.Legendary.Guild.Name = "The GOATS"

# Level-1 beggars - underwear, sparse begging/dance emotes and varied local chat.
# The default range is 1-1. CreateMissing can supply a matching bot if the normal pool has none.
# Set MinLevel and MaxLevel to the same other value to request another exact beggar level.
CityLife.Custom.Beggar.Enable = 1
CityLife.Custom.Beggar.MinLevel = 1
CityLife.Custom.Beggar.MaxLevel = 1
CityLife.Custom.Beggar.Stormwind.Population = 1
CityLife.Custom.Beggar.Orgrimmar.Population = 1
CityLife.Custom.Beggar.ChatMinSeconds = 180
CityLife.Custom.Beggar.ChatMaxSeconds = 420
CityLife.Custom.Beggar.YellChancePct = 20
# Separate idle emotes; dancing ends after the configured short duration.
CityLife.Custom.Beggar.EmoteMinSeconds = 45
CityLife.Custom.Beggar.EmoteMaxSeconds = 120
CityLife.Custom.Beggar.DanceChancePct = 25
CityLife.Custom.Beggar.DanceSeconds = 8

# Roam near the original plaza anchor, pausing to beg/dance; validated dry-ground walking paths only.
# Radius is yards from the fixed hub spot, so repeated trips never drift away from the square.
# Walk = 0 runs; Walk = 1 walks. Other resident movement settings remain independent.
CityLife.Custom.Beggar.Wander.Enable = 1
CityLife.Custom.Beggar.Wander.Radius = 10
CityLife.Custom.Beggar.Wander.MinSeconds = 10
CityLife.Custom.Beggar.Wander.MaxSeconds = 25
CityLife.Custom.Beggar.Wander.Walk = 0

# Occasionally request a normal trade with a nearby available real player of the same faction.
# Chance is checked after each random interval; per-player cooldown is shared across all beggars.
# Ignore/DND/AFK, combat, movement and core trade restrictions are respected.
# Flavor request only: the beggar does not accept/complete item or gold transfers.
# The bot cancels its own unanswered/open request after DurationSeconds, or when its role ends.
CityLife.Custom.Beggar.Trade.Enable = 1
CityLife.Custom.Beggar.Trade.MinSeconds = 180
CityLife.Custom.Beggar.Trade.MaxSeconds = 420
CityLife.Custom.Beggar.Trade.ChancePct = 25
CityLife.Custom.Beggar.Trade.Range = 8
CityLife.Custom.Beggar.Trade.DurationSeconds = 15
CityLife.Custom.Beggar.Trade.PlayerCooldownSeconds = 600

# Buyers advertise level 70-80 green gear for 10 gold; these are ambient messages only.
# They do not automatically trade, accept an item or pay gold. Text remains in city_life_custom_chat.
CityLife.Custom.Buyer.Enable = 1
CityLife.Custom.Buyer.MinLevel = 1
CityLife.Custom.Buyer.MaxLevel = 80
CityLife.Custom.Buyer.Stormwind.Population = 1
CityLife.Custom.Buyer.Orgrimmar.Population = 1
CityLife.Custom.Buyer.Dalaran.Population = 1
CityLife.Custom.Buyer.ChatMinSeconds = 180
CityLife.Custom.Buyer.ChatMaxSeconds = 420
CityLife.Custom.Buyer.YellChancePct = 0

# Training uses existing practice dummies only, alternating practice and rest.
# No Dalaran site is bundled because the local base data has no city training dummy there.
CityLife.Custom.TrainingDummy.Enable = 1
CityLife.Custom.TrainingDummy.MinLevel = 80
CityLife.Custom.TrainingDummy.MaxLevel = 80
CityLife.Custom.TrainingDummy.Stormwind.Population = 1
CityLife.Custom.TrainingDummy.Orgrimmar.Population = 1
CityLife.Custom.TrainingDummy.PracticeMinSeconds = 60
CityLife.Custom.TrainingDummy.PracticeMaxSeconds = 180
CityLife.Custom.TrainingDummy.RestMinSeconds = 15
CityLife.Custom.TrainingDummy.RestMaxSeconds = 45
CityLife.Custom.TrainingDummy.TargetRange = 15
# Existing AzerothCore practice dummy entries; every target must also use npc_training_dummy.
CityLife.Custom.TrainingDummy.TargetEntries = "31144,31146,32666,32667"

# Player reactions reuse existing residents. Target a resident with /wave, /bow or /dance.
# Chance and per-player/per-bot cooldowns prevent repeated responses flooding the scene.
CityLife.Custom.PlayerReactions.Enable = 1
CityLife.Custom.PlayerReactions.ChancePct = 70
CityLife.Custom.PlayerReactions.CooldownSeconds = 30
CityLife.Custom.PlayerReactions.Range = 20

# Conversations reuse two nearby residents: question -> reply -> thanks.
# A nearby real player is required; missing/busy/moved participants cancel a pending exchange.
# Text/channel/faction data lives in city_life_custom_chat; each group has steps 0, 1 and 2.
CityLife.Custom.Conversations.Enable = 1
CityLife.Custom.Conversations.MinSeconds = 180
CityLife.Custom.Conversations.MaxSeconds = 420
CityLife.Custom.Conversations.Range = 25
CityLife.Custom.Conversations.PartnerRange = 12
CityLife.Custom.Conversations.ReplyMinSeconds = 2
CityLife.Custom.Conversations.ReplyMaxSeconds = 5
CityLife.Custom.Conversations.MaxConcurrent = 2


###################################################################################################
# 11 - FISHING LIFE
###################################################################################################
# Independent component with its own settings; CityLife.Custom.Enable does not control fishing.
# CityLife.Enable must be ON because Fishing Life uses its shared scheduler and population cap.
# Apply data/sql/manual/world_city_life_fishing.sql to WORLD after world_city_life_custom.sql.
# The historical equipment recovery/managed-bot CHARACTERS tables are shared; identities are preserved.
# These are real playerbots displaying a pole and casting; no fishing loot or skill farming.
# Default request: 46 fishing slots across 20 locations, inside CityLife.Population.MaxTotal = 300.
# Counts are requests: eligible bots, safe dry ground, reachable water and free space are required.
# Set a location's Enable to 0 or Population to 0 to stop only that waterfront.
# Routine switches, populations, levels and timing are configured here; coordinates/chat remain data.

FishingLife.Enable = 1

# Missing participants can be created/logged in through a SEPARATE managed fishing pool.
# Existing registered fishing identities, including the original three, count against this quota only.
# MaxBots counts persistent records/pending work; it does not guarantee that many active fishers.
# Disable CreateMissing to stop NEW character creation; registered eligible characters remain reusable.
# Extra managed sessions count toward total online bots and server capacity, outside random-bot targets.
# Example: 1,000 total online - 440 default Life planning peak leaves 560 nominal free dungeon/BG bots.
# Check free level-80 dungeon roles and BG brackets separately; see section 02 for population planning.
FishingLife.CreateMissing.Enable = 1
FishingLife.CreateMissing.MaxBots = 46
FishingLife.CreateMissing.CreateIntervalSeconds = 30
# 1-8 letters/digits, distinct from Custom and Playerbots random-account prefixes.
FishingLife.CreateMissing.AccountPrefix = "fishlife"

# Keep fishing populations constant; 1 applies CityLife.Time multipliers.
FishingLife.TimeScaling = 0
# 0 keeps an available participant assigned; positive seconds request rotation.
FishingLife.ResidenceSeconds = 0

# Global level bounds constrain every location. Each location also has its own bounds below.
# Existing higher-level characters are never lowered to fill a requested range.
FishingLife.MinLevel = 1
FishingLife.MaxLevel = 80

# Minimum separation in yards. If safe shore space is exhausted, fewer bots appear rather than stack.
FishingLife.MinimumSpacing = 2

# Maximum dry-ground height above/below the water in yards, useful for docks (default 12).
# Water depth and line-of-sight checks remain mandatory; raising this does not create safe ground.
FishingLife.MaximumWaterHeightDifference = 12

# Sparse fishing cast/channel timing. PoleItem must be a usable real fishing pole.
# Newly provisioned fishers learn fishing; borrowed bots must already qualify to equip the pole.
FishingLife.CastMinSeconds = 20
FishingLife.CastMaxSeconds = 35
FishingLife.Spell = 7620
FishingLife.PoleItem = 6256

# Fishing chat requires a nearby real player of the same faction/map/phase.
# Text remains in city_life_custom_chat, group_name = fishing (legacy table name retained).
FishingLife.Chat.Range = 40
FishingLife.ChatMinSeconds = 180
FishingLife.ChatMaxSeconds = 420
FishingLife.YellChancePct = 0

# During Wintergrasp battles, release local fishing assignments and restore their equipment.
# The normal scheduler can refill them after the battle; no fishing is forced into active combat.
FishingLife.Wintergrasp.PauseDuringBattle = 1

