+bool Transmogrification::IsCityLifeTemporary(Player const* player, Item const* item) const
+{
+    if (!player || !item || item->GetOwnerGUID() != player->GetGUID())
+        return false;
+    auto registered = _cityLifeTemporaryOwners.find(item->GetGUID());
+    if (registered != _cityLifeTemporaryOwners.end() && registered->second == player->GetGUID())
+        return true;
+#if defined(CITY_LIFE_TRANSMOG_BRIDGE)
+    // The startup journal cache also covers a login that reaches retroactive collection before recovery.
+    return sCityLifeCustomAppearance.IsTemporaryItem(player, item);
+#else
+    return false;
+#endif
+}
+
+bool Transmogrification::RegisterCityLifeTemporary(Player const* player, Item const* item)
+{
+#if defined(CITY_LIFE_TRANSMOG_BRIDGE)
+    if (!player || !item || item->GetOwnerGUID() != player->GetGUID() ||
+        !sCityLifeCustomAppearance.IsTemporaryItem(player, item) ||
+        !PlayerbotsLife::IsReservedBy(player->GetGUID().GetCounter(),
+            PlayerbotsLife::ReservationOwner::CustomLife))
+        return false;
+    auto existing = dataMap.find(item->GetGUID());
+    if (existing != dataMap.end() && existing->second != player->GetGUID())
+        return false;
+    _cityLifeTemporaryOwners[item->GetGUID()] = player->GetGUID();
+    return true;
+#else
+    (void)player;
+    (void)item;
+    return false;
+#endif
+}
+
+bool Transmogrification::SetCityLifeTemporaryAppearance(Player* player, Item* item, uint8 slot, uint32 entry)
+{
+    if (!IsEnabled() || !player || !item || slot >= EQUIPMENT_SLOT_END || !item->IsEquipped() ||
+        item->GetSlot() != slot || item->GetOwnerGUID() != player->GetGUID())
+        return false;
+    auto registered = _cityLifeTemporaryOwners.find(item->GetGUID());
+    if (registered == _cityLifeTemporaryOwners.end() || registered->second != player->GetGUID() ||
+        !IsCityLifeTemporary(player, item))
+        return false;
+    if (entry == HIDDEN_ITEM_ID)
+    {
+        if (slot != EQUIPMENT_SLOT_OFFHAND)
+            return false;
+    }
+    else
+    {
+        ItemTemplate const* appearance = sObjectMgr->GetItemTemplate(entry);
+        ItemTemplate const* equipped = item->GetTemplate();
+        if (!appearance || !equipped || appearance->Class != equipped->Class ||
+            (appearance->Class != ITEM_CLASS_ARMOR && appearance->Class != ITEM_CLASS_WEAPON))
+            return false;
+    }
+    // Deliberately do not call SetFakeEntry/Transmogrify: this display has no persisted fake row,
+    // source item, collection unlock, charge, binding change or alteration to real item statistics.
+    entryMap[player->GetGUID()][item->GetGUID()] = entry;
+    dataMap[item->GetGUID()] = player->GetGUID();
+    UpdateItem(player, item);
+    return true;
+}
+
+void Transmogrification::ForgetCityLifeTemporary(Player const* player, ObjectGuid itemGuid)
+{
+    auto registered = _cityLifeTemporaryOwners.find(itemGuid);
+    if (registered == _cityLifeTemporaryOwners.end() || !player || registered->second != player->GetGUID())
+        return;
+    auto owner = dataMap.find(itemGuid);
+    if (owner != dataMap.end() && owner->second == registered->second)
+    {
+        auto entries = entryMap.find(registered->second);
+        if (entries != entryMap.end())
+        {
+            entries->second.erase(itemGuid);
+            if (entries->second.empty())
+                entryMap.erase(entries);
+        }
+        dataMap.erase(owner);
+    }
+    _cityLifeTemporaryOwners.erase(registered);
+}
+
+void Transmogrification::ForgetCityLifeTemporaryOwner(Player const* player)
+{
+    if (!player)
+        return;
+    std::vector<ObjectGuid> items;
+    for (auto const& entry : _cityLifeTemporaryOwners)
+        if (entry.second == player->GetGUID())
+            items.push_back(entry.first);
+    for (ObjectGuid guid : items)
+        ForgetCityLifeTemporary(player, guid);
+}
